# Local runtime and path settings for the 779-server SING MCP pool.
# Copy to dataset/.env and fill addresses, paths, ports, IDs, usernames,
# and other non-secret settings needed by selected servers.
# Keys, tokens, passwords, and credential-bearing connection strings belong
# in dataset/api.env.
# The renderer reads both files as data; do not source them.
# All values are intentionally empty.
#

# ======================================================================
# Local path variables (not credentials)
# ======================================================================
# Directory for additional server code downloaded with
# python3 dataset/prepare_local_sources.py --clone.
# Use an absolute path here, not $HOME or ~.
MCPDATA_ROOT=
# Absolute bin directory of Node.js 20, used by two Node 24-incompatible entries.
NODE20_BIN=
# Absolute bin directory of a Python venv with mcp<2 for npm Python wrappers.
PYTHON_MCP_BIN=
# Absolute bin directory of a Python venv with fastmcp for ohcard.
OHCARD_PYTHON_BIN=
# Absolute Python 3.13 executable with weather-mcp-server and mcp<2 installed.
WEATHER_DATA_PYTHON=
# Absolute path to the extracted GitHub MCP server binary.
GITHUB_MCP_SERVER_BIN=
# Workspace directory used by the likec4 server.
LIKEC4_WORKSPACE=

# Server-specific local paths.
# Used by: flyworks
FLYWORKS_MCP_BASE_PATH=
# Used by: gdrive
GDRIVE_CREDS_DIR=
# Used by: project-explorer
PROJECT_EXPLORER_PATH=
# Used by: taskflow
TASK_MANAGER_FILE_PATH=
# Used by: terminal
TERMINAL_ALLOWED_PATH=

# Service addresses and non-secret settings
# Used by: connectwise api gateway mcp server
CONNECTWISE_API_URL=
# Used by: connectwise api gateway mcp server
CONNECTWISE_COMPANY_ID=
# Used by: agentset
AGENTSET_NAMESPACE_ID=
# Used by: feishu-mcp
FEISHU_APP_ID=
# Used by: meme
IMGFLIP_USERNAME=
# Used by: plane
PLANE_API_HOST_URL=
# Used by: <name_of_your_documentation_no_spaces>
