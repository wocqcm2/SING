# API credentials for the 779-server SING MCP pool.
# Copy to dataset/api.env and fill only the credentials needed by selected servers.
# Keys, tokens, passwords, and connection strings that may contain passwords
# belong here. Addresses, paths, ports, IDs, and usernames belong in .env.
# The renderer reads this file as data; do not source or execute it.
# All values are intentionally empty. Never commit dataset/api.env.

# Used by: 360 AI Cloud Drive MCP Server
AI_CLOUD_360_API_KEY=
# Used by: hefeng-weather
API_KEY=
